# JavaInfoHunter Environment Variables Template
# Copy this file to .env and configure with your actual values
# IMPORTANT: Never commit .env file to version control!

# ========================================
# Database Configuration
# ========================================
DB_USERNAME=admin
DB_PASSWORD=admin123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=javainfohunter
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=3
DB_POOL_CONN_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000

# Flyway ownership (recommended: only API service executes migrations)
API_FLYWAY_ENABLED=true
CRAWLER_FLYWAY_ENABLED=false
PROCESSOR_FLYWAY_ENABLED=false

# ========================================
# RabbitMQ Configuration
# ========================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=25672
RABBITMQ_USERNAME=your_rabbitmq_username
RABBITMQ_PASSWORD=your_secure_rabbitmq_password
CRAWLER_RABBITMQ_CONCURRENCY=3
CRAWLER_RABBITMQ_MAX_CONCURRENCY=10
CRAWLER_RABBITMQ_PREFETCH=10
PROCESSOR_RABBITMQ_CONCURRENCY=2
PROCESSOR_RABBITMQ_MAX_CONCURRENCY=4
PROCESSOR_RABBITMQ_PREFETCH=3
CRAWLER_MAX_CONCURRENT_SOURCES=8
PROCESSING_API_CONCURRENCY_LIMIT=6

# ========================================
# Redis Configuration
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password

# ========================================
# AI Service Configuration
# ========================================
# Alibaba DashScope API Key
# Get your key from: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Enable/disable AI features
AI_ENABLED=true

# ========================================
# Application Configuration
# ========================================
# Server port (default: 8080)
SERVER_PORT=8080

# Active profile (dev, staging, prod)
SPRING_PROFILES_ACTIVE=dev

# Logging level (TRACE, DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
STARTUP_VALIDATION_ENABLED=true

# ========================================
# Security Configuration
# ========================================
# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here_generate_with_openssl

# JWT Expiration (in milliseconds, default: 86400000 = 24 hours)
JWT_EXPIRATION=86400000
